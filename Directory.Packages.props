<!--
  Central Package Management: every PackageReference version is pinned here, not in csproj files.
  https://learn.microsoft.com/nuget/consume-packages/central-package-management
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- CQRS via source-generated Mediator (martinothamar) — NOT MediatR. -->
  <ItemGroup>
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
  </ItemGroup>

  <!-- Mapping (compile-time, source-generated) -->
  <ItemGroup>
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>

  <!-- Presentation (WPF): tray icon (H.NotifyIcon) + MVVM source generators (CommunityToolkit.Mvvm).
       Presentation-only; both are Windows/WPF concerns. -->
  <ItemGroup>
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Audio: WASAPI capture + device enumeration (NAudio). Infrastructure-only; Windows at runtime. -->
  <ItemGroup>
    <PackageVersion Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageVersion Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>

  <!--
    Global keyboard hook (SharpHook over libuiohook). Infrastructure-only: backs the IHotkeyListener
    port with a focus-independent hook that, unlike Win32 RegisterHotKey, can model push-to-talk
    hold/release and bind F13. No network egress.
  -->
  <ItemGroup>
    <PackageVersion Include="SharpHook" Version="7.1.2" />
  </ItemGroup>

  <!-- On-device voice-activity detection (Silero VAD via ONNX Runtime). Infrastructure-only; no egress. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <!--
    On-device transcription (Whisper.net) with Vulkan GPU acceleration + CPU fallback. Infrastructure-
    only; transcription is fully local (no network egress). The Runtime packages ship the native
    whisper.cpp binaries (CPU + Vulkan); the GPU contact point picks the order at load time.
  -->
  <ItemGroup>
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <!-- Validation -->
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <!-- Microsoft.Extensions (composition, configuration, logging) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
  </ItemGroup>

  <!-- Logging: Serilog -->
  <ItemGroup>
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.Microsoft.Extensions.DependencyInjection" Version="3.3.4" />
  </ItemGroup>

  <!--
    MinVer derives the assembly version from git tags (see Directory.Build.props). GlobalPackageReference
    applies it to every project that participates in central package management without each project
    listing it.
  -->
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
