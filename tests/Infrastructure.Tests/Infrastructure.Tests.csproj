<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for Infrastructure adapters' device-independent logic — the depth behind the @WHISPER
    acceptance scenarios. Adapters are driven over fake low-level seams (no real device); the actual
    native glue (NAudio, ONNX) is verified by manual real-device smoke, not here. References
    Infrastructure, which transitively brings Application + Domain + Logic.*. xUnit v3 test projects
    are executables.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
