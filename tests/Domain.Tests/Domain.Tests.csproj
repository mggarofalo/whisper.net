<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the Domain layer — exhaustive, fast coverage of the entities and value objects and
    every invariant they enforce. This is the inner xUnit loop behind the domain
    scenarios. Uses AwesomeAssertions for expressive assertions; xUnit v3 test projects are
    executables.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Domain\Domain.csproj" />
  </ItemGroup>

</Project>
