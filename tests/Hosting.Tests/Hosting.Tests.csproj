<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests for the Generic Host composition. Builds a host from the same
    per-layer registration extensions the WPF app uses (via AddWhisperServices + AddSerilogLogging in
    Infrastructure) and asserts the wiring resolves and that Serilog honors the configured level.
    References Infrastructure, which transitively brings Application + Logic.* + Domain. xUnit v3 test
    projects are executables.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!-- Speech fixture for the @slow real-model VAD test: 16 kHz mono 16-bit PCM. -->
  <ItemGroup>
    <Content Include="Audio\speech.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
