<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the Logic.AppManagement behaviors — the inner xUnit TDD loop the outer BDD
    scenarios drive down into. Uses AwesomeAssertions for expressive assertions; xUnit v3 test
    projects are executables.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Logic.AppManagement\Logic.AppManagement.csproj" />
  </ItemGroup>

</Project>
