<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Presentation: the WPF tray application and composition root. The ONLY project permitted to
    reference Infrastructure; it wires every layer together via the Generic Host.
    Windows-only by necessity (WPF), so it retargets to net10.0-windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- The installer + the in-exe icon. One asset, shared by the build and `vpk pack`. -->
    <ApplicationIcon>..\..\assets\whisper.ico</ApplicationIcon>
    <!--
      User-facing name. The assembly (and so Presentation.exe, which pack.ps1 launches by name) stays
      "Presentation", but AssemblyTitle drives the Win32 FileDescription that Windows shows in the
      taskbar / notification-area personalization list, so the app reads as "Whisper" there.
    -->
    <AssemblyTitle>Whisper</AssemblyTitle>
    <Product>Whisper</Product>
  </PropertyGroup>

  <!--
    Velopack packaging: when a runtime identifier is supplied (the packaging script and the
    release CI publish with `-r win-x64`), publish a self-contained, single-file build with the .NET 10
    runtime bundled, so an end user installs without a separate .NET install. A normal dev build supplies
    no RID, so this group is inert and `dotnet build` / the specs are unaffected.

    Native libraries are deliberately NOT embedded for self-extract: Whisper.net's
    NativeLibraryLoader resolves whisper.dll/ggml relative to AppContext.BaseDirectory and cannot find them
    when they are packed into the single file and self-extracted to a temp dir — which silently broke ALL
    transcription in the installed app. With IncludeNativeLibrariesForSelfExtract=false the managed code
    still bundles into the single exe, but the native libraries stay as loose files in runtimes/win-x64/
    native next to the exe, where the loader finds them. Velopack packages the whole folder anyway.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Declarative event wiring: EventTrigger/InvokeCommandAction + Behavior<T> infra. -->
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <!-- In-app install/update hooks; the UpdateManager auto-update flow follows separately. -->
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      Tray glyphs: the speech bubble tinted per recording state. Embedded as WPF resources so the
      RecordingStateToIconSourceConverter can address them by pack:// URI. They must be .ico (not .png):
      H.NotifyIcon resolves the IconSource URI to a stream and feeds it to System.Drawing.Icon, which
      only parses the ICO container. Re-render from assets/whisper.svg if the brand changes.
    -->
    <Resource Include="Resources\tray-idle.ico" />
    <Resource Include="Resources\tray-recording.ico" />
    <Resource Include="Resources\tray-transcribing.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\Logic.AppManagement\Logic.AppManagement.csproj" />
    <ProjectReference Include="..\Logic.AudioManagement\Logic.AudioManagement.csproj" />
    <ProjectReference Include="..\Logic.ModelManagement\Logic.ModelManagement.csproj" />
    <ProjectReference Include="..\Logic.GpuContactPoint\Logic.GpuContactPoint.csproj" />
  </ItemGroup>

</Project>
