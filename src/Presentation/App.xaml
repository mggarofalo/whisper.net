<Application x:Class="Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No shell resources here on purpose (WHISPER-152). App.xaml is parsed before OnStartup sets ThemeMode,
         so a merge here would build ShellResources' implicit styles (BasedOn the theme's TextBox style, and so
         on) on the classic Windows theme instead of Fluent, and that app-wide copy shadows the window's. The
         shell window merges ShellResources itself, after the Fluent theme is in place. -->
</Application>