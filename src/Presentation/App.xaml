<Application x:Class="Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The shell's shared converters + validation chrome (WHISPER-96): owned by a standalone
                     dictionary the shell window also merges, so views resolve them with or without a live
                     Application. Merged here too so any future window gets them app-wide. -->
                <ResourceDictionary Source="/Presentation;component/Shell/ShellResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
