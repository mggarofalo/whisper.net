<UserControl x:Class="Presentation.Shell.Views.ModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock Text="Model"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,12,0,0">
            <TextBlock Text="Active model:"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding ActiveModelId, TargetNullValue='(none loaded)'}"
                       Margin="8,0,0,0"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
        <Button Content="Refresh"
                Command="{Binding LoadCommand}"
                Margin="0,12,0,0"
                Padding="12,4"
                HorizontalAlignment="Left" />
        <TextBlock Text="The full model picker (ratings, downloads, switching) arrives in WHISPER-27."
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.7" />
    </StackPanel>
</UserControl>
