<UserControl x:Class="Presentation.Shell.Views.ModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Local">
    <UserControl.Resources>
        <!-- Declared locally (WHISPER-96) so the view is self-contained: parse-time StaticResource only
             sees the view's own resources and the Application, and the smoke harness composes without one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock Text="Model"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding ActiveModelId, StringFormat='Active: {0}', TargetNullValue='Active: (none)'}"
                       Margin="16,0,0,0"
                       Opacity="0.8"
                       VerticalAlignment="Center" />
            <Button Content="Refresh"
                    AutomationProperties.Name="Refresh model list"
                    Command="{Binding LoadCommand}"
                    Margin="16,0,0,0"
                    Padding="12,4" />
            <!-- Lightweight loading state (WHISPER-108): visible while the activation-triggered load runs. -->
            <TextBlock Text="Loading…"
                       Opacity="0.7"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding LoadCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- One row per model: name, the three ratings, download progress, and a select/download action.
             Wrapped in a ScrollViewer (WHISPER-104) so the list scrolls when rows exceed the window
             height; the header above is DockPanel.Dock="Top" and stays fixed. Matches HistoryView. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="0,8">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Id}"
                                           Opacity="0.6"
                                           FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Speed, StringFormat='Speed: {0}'}"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Accuracy, StringFormat='Accuracy: {0}'}"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Memory, StringFormat='RAM: {0}'}" />
                                <ProgressBar Value="{Binding DownloadPercent}"
                                             AutomationProperties.Name="{Binding DisplayName, StringFormat='Download progress for {0}'}"
                                             Width="80"
                                             Height="6"
                                             Margin="12,0,0,0"
                                             VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Active"
                                           Foreground="Green"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                <!-- This row's own download command (WHISPER-107): disabled only while THIS row
                                     downloads, so other rows stay interactive and can download concurrently. -->
                                <Button Content="Download"
                                        AutomationProperties.Name="{Binding DisplayName, StringFormat='Download {0}'}"
                                        Command="{Binding DownloadCommand}"
                                        Margin="0,0,8,0"
                                        Padding="12,4" />
                                <!-- Cancel only this row's in-flight download; shown only while this row is running. -->
                                <Button Content="Cancel"
                                        AutomationProperties.Name="{Binding DisplayName, StringFormat='Cancel download for {0}'}"
                                        Command="{Binding DownloadCancelCommand}"
                                        Margin="0,0,8,0"
                                        Padding="12,4"
                                        Visibility="{Binding DownloadCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Select"
                                        AutomationProperties.Name="{Binding DisplayName, StringFormat='Select {0}'}"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="12,4" />
                            </StackPanel>
                        </Grid>
                        <!-- A failed download surfaces per row natively (WHISPER-81/107), not as a crash;
                             empty (and effectively invisible) when this row has no error. -->
                        <TextBlock Text="{Binding DownloadError}"
                                   Foreground="#C03030"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
