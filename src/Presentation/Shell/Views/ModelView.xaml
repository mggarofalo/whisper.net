<UserControl x:Class="Presentation.Shell.Views.ModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock Text="Model"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding ActiveModelId, StringFormat='Active: {0}', TargetNullValue='Active: (none)'}"
                       Margin="16,0,0,0"
                       Opacity="0.8"
                       VerticalAlignment="Center" />
            <Button Content="Refresh"
                    Command="{Binding LoadCommand}"
                    Margin="16,0,0,0"
                    Padding="12,4" />
        </StackPanel>

        <!-- One row per model: name, the three ratings, download progress, and a select/download action. -->
        <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Id}"
                                           Opacity="0.6"
                                           FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Speed, StringFormat='Speed: {0}'}"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Accuracy, StringFormat='Accuracy: {0}'}"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Memory, StringFormat='RAM: {0}'}" />
                                <ProgressBar Value="{Binding DownloadPercent}"
                                             Width="80"
                                             Height="6"
                                             Margin="12,0,0,0"
                                             VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Active"
                                           Foreground="Green"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Select"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="12,4" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
