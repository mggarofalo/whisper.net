<UserControl x:Class="Presentation.Shell.Views.ModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Presentation.Behaviors"
             KeyboardNavigation.TabNavigation="Local">
    <UserControl.Resources>
        <!-- Declared locally so the view is self-contained: parse-time StaticResource only
             sees the view's own resources and the Application, and the smoke harness composes without one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A Low/Medium/High rating as a three-dot meter: every dot lit for High, two for Medium, one for Low.
             An unlit dot is the text colour, faded well back, so it reads as empty in either theme. -->
        <DataTemplate x:Key="RatingDots">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse Style="{DynamicResource RatingDot}" />
                <Ellipse x:Name="Second"
                         Style="{DynamicResource RatingDot}" />
                <Ellipse x:Name="Third"
                         Style="{DynamicResource RatingDot}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}"
                             Value="Low">
                    <Setter TargetName="Second"
                            Property="Fill"
                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter TargetName="Second"
                            Property="Opacity"
                            Value="0.2" />
                    <Setter TargetName="Third"
                            Property="Fill"
                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter TargetName="Third"
                            Property="Opacity"
                            Value="0.2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}"
                             Value="Medium">
                    <Setter TargetName="Third"
                            Property="Fill"
                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter TargetName="Third"
                            Property="Opacity"
                            Value="0.2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Rating meters give way to the progress bar while the row downloads. -->
        <Style x:Key="HiddenWhileDownloading"
               TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDownloading}"
                             Value="True">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Typography, spacing and colour come from the shared tokens in ShellResources.xaml (WHISPER-142). -->
    <DockPanel Margin="{DynamicResource PageMargin}">
        <!-- Page header: the title with a one-line explanation under it, and the page command on the right. The
             model in use is the list's selection, so the header no longer repeats it. -->
        <Grid DockPanel.Dock="Top"
              Margin="{DynamicResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Model"
                           Style="{DynamicResource PageTitle}" />
                <TextBlock Text="Choose the model to dictate with. Choosing one that isn't on this device downloads it first."
                           Style="{DynamicResource CaptionText}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <!-- Lightweight loading state: visible while the activation-triggered load runs. -->
            <TextBlock Grid.Column="1"
                       Text="Loading…"
                       Style="{DynamicResource CaptionText}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding LoadCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="2"
                    Content="{DynamicResource GlyphRefresh}"
                    FontFamily="{DynamicResource IconFont}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    VerticalAlignment="Center"
                    ToolTip="Refresh model list"
                    AutomationProperties.Name="Refresh model list"
                    Command="{Binding LoadCommand}" />
        </Grid>

        <!-- WHISPER-149: the models are a single-selection list, and the selection IS the model in use. It is
             bound one way from ActiveModel, which only moves once a switch succeeds. CommandedSelectionBehavior
             turns choosing a row (click, Space or Enter) into SelectCommand and keeps the selection on the model
             in use until then; arrow keys move focus without choosing, so browsing never starts a download. The
             trailing slot carries only the download lifecycle: Download (without switching) and Cancel. -->
        <ListBox ItemsSource="{Binding Models}"
                 SelectedItem="{Binding ActiveModel, Mode=OneWay}"
                 SelectionMode="Single"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,0,16,0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 KeyboardNavigation.TabNavigation="Continue"
                 AutomationProperties.Name="Models">
            <b:Interaction.Behaviors>
                <behaviors:CommandedSelectionBehavior Command="{Binding SelectCommand}" />
            </b:Interaction.Behaviors>
            <!-- Each row is announced by its name and state ("Small (English), On this device"), not the row
                 view-model's type name. BasedOn keeps the Fluent item template: hover, focus and the selection. -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem"
                       BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0}, {1}">
                                <Binding Path="DisplayName" />
                                <Binding Path="StatusText" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    <!-- The Fluent item fills the selected row with the accent; the model in use is marked the way
                         the Windows 11 lists and nav mark selection instead: a subtle fill and a short accent pill
                         at the leading edge. Hover is the same subtle fill, so the row reads as one control. -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Chrome"
                                        Background="Transparent"
                                        CornerRadius="4"
                                        Margin="0,1"
                                        Padding="12,6,8,6">
                                    <Grid>
                                        <Rectangle x:Name="Pill"
                                                   Width="3"
                                                   Height="16"
                                                   RadiusX="1.5"
                                                   RadiusY="1.5"
                                                   Margin="-9,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                   Visibility="Collapsed" />
                                        <ContentPresenter />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Chrome"
                                                Property="Background"
                                                Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter TargetName="Chrome"
                                                Property="Background"
                                                Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter TargetName="Pill"
                                                Property="Visibility"
                                                Value="Visible" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected"
                                                       Value="True" />
                                            <Condition Property="IsMouseOver"
                                                       Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Chrome"
                                                Property="Background"
                                                Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: name, then id · size · state, then the ratings (or this row's progress). -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource FieldLabel}" />
                            <TextBlock Text="{Binding Caption}"
                                       Style="{DynamicResource CaptionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,6,0,0"
                                        Style="{StaticResource HiddenWhileDownloading}">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,14,0"
                                            AutomationProperties.Name="{Binding Speed, StringFormat='Speed: {0}'}">
                                    <TextBlock Text="Speed"
                                               Style="{DynamicResource CaptionText}"
                                               Margin="0,0,6,0" />
                                    <ContentControl Content="{Binding Speed}"
                                                    ContentTemplate="{StaticResource RatingDots}"
                                                    Focusable="False" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,14,0"
                                            AutomationProperties.Name="{Binding Accuracy, StringFormat='Accuracy: {0}'}">
                                    <TextBlock Text="Accuracy"
                                               Style="{DynamicResource CaptionText}"
                                               Margin="0,0,6,0" />
                                    <ContentControl Content="{Binding Accuracy}"
                                                    ContentTemplate="{StaticResource RatingDots}"
                                                    Focusable="False" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            AutomationProperties.Name="{Binding Memory, StringFormat='RAM: {0}'}">
                                    <TextBlock Text="RAM"
                                               Style="{DynamicResource CaptionText}"
                                               Margin="0,0,6,0" />
                                    <ContentControl Content="{Binding Memory}"
                                                    ContentTemplate="{StaticResource RatingDots}"
                                                    Focusable="False" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Progress: shown only while this row is downloading. -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Value="{Binding DownloadPercent}"
                                             AutomationProperties.Name="{Binding DisplayName, StringFormat='Download progress for {0}'}"
                                             Width="160"
                                             VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DownloadPercent, StringFormat='{}{0:0}%'}"
                                           Style="{DynamicResource CaptionText}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- A failed download or switch surfaces on its row; empty when there is none. -->
                            <TextBlock Text="{Binding ErrorText}"
                                       Style="{DynamicResource ErrorText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Right: the download lifecycle only, in one 32x32 slot. -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="{DynamicResource GlyphDownload}"
                                    FontFamily="{DynamicResource IconFont}"
                                    Width="{DynamicResource RowIconSize}"
                                    Height="{DynamicResource RowIconSize}"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    ToolTip="Download without switching"
                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Download {0}'}"
                                    Command="{Binding DownloadCommand}"
                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{DynamicResource GlyphCancel}"
                                    FontFamily="{DynamicResource IconFont}"
                                    Width="{DynamicResource RowIconSize}"
                                    Height="{DynamicResource RowIconSize}"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    ToolTip="Cancel download"
                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Cancel download for {0}'}"
                                    Command="{Binding DownloadCancelCommand}"
                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
