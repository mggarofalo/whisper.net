<UserControl x:Class="Presentation.Shell.Views.HotkeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock Text="Dictation hotkey"
                   FontSize="18"
                   FontWeight="SemiBold" />

        <StackPanel Orientation="Horizontal"
                    Margin="0,12,0,0">
            <TextBlock Text="Current:"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentHotkey, TargetNullValue='(none)'}"
                       Margin="8,0,0,0"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Margin="0,12,0,0">
            <TextBox x:Name="ChordBox"
                     Width="200"
                     VerticalContentAlignment="Center"
                     Padding="6,4" />
            <Button Content="Assign"
                    Command="{Binding AssignCommand}"
                    CommandParameter="{Binding Text, ElementName=ChordBox}"
                    Margin="8,0,0,0"
                    Padding="12,4" />
        </StackPanel>

        <TextBlock Text="{Binding Error}"
                   Foreground="#C03030"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
