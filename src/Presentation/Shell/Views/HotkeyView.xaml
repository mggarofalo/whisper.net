<UserControl x:Class="Presentation.Shell.Views.HotkeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Presentation.Behaviors"
             xmlns:controls="clr-namespace:Presentation.Shell.Controls"
             KeyboardNavigation.TabNavigation="Local">
    <!-- AdornerDecorator so the validated chord field renders its native error adorner. Typography,
         spacing and colour come from the shared tokens in ShellResources.xaml (WHISPER-142). -->
    <AdornerDecorator>
        <StackPanel Margin="{DynamicResource PageMargin}">
            <TextBlock Text="Hotkey"
                       Style="{DynamicResource PageTitle}"
                       Margin="{DynamicResource PageHeaderMargin}" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Current:"
                           Style="{DynamicResource BodyText}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentHotkey, TargetNullValue='(none)'}"
                           Style="{DynamicResource FieldLabel}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="{DynamicResource GapGroup}">
                <!-- The capture control records a pressed combination into the validated HotkeyInput, so an
                     invalid/unregisterable combo flags an adorner and the Save button (gated by
                     AssignCommand.CanExecute) disables. Press Esc/Backspace in the field to clear. The
                     focus-on-activate behavior puts the keyboard in the capture field each
                     time the section is shown. -->
                <controls:HotkeyCaptureControl AutomationProperties.Name="Dictation hotkey"
                                               Chord="{Binding HotkeyInput, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                    <b:Interaction.Behaviors>
                        <behaviors:FocusOnActivateBehavior />
                    </b:Interaction.Behaviors>
                </controls:HotkeyCaptureControl>
                <Button Content="Assign"
                        AutomationProperties.Name="Assign hotkey"
                        Command="{Binding AssignCommand}"
                        Margin="8,0,0,0"
                        Padding="12,4" />
            </StackPanel>

            <TextBlock Text="Click the field, then press the key combination you want to use for dictation."
                       Style="{DynamicResource CaptionText}"
                       Margin="0,4,0,0" />

            <TextBlock Text="{Binding Error}"
                       Style="{DynamicResource ErrorText}"
                       Margin="{DynamicResource GapTight}" />
        </StackPanel>
    </AdornerDecorator>
</UserControl>
