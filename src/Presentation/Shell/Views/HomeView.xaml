<UserControl x:Class="Presentation.Shell.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Presentation.Shell">
    <UserControl.Resources>
        <!-- Declared locally so the view is self-contained: parse-time StaticResource only
             sees the view's own resources and the Application, and the smoke harness composes without one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Render stored-UTC timestamps in the user's local time; storage stays UTC. -->
        <shell:UtcToLocalConverter x:Key="UtcToLocal" />
    </UserControl.Resources>
    <!-- Typography, spacing and colour come from the shared tokens in ShellResources.xaml (WHISPER-142).
         The shared scroll style reserves a right gutter so the overlay scrollbar never covers content. -->
    <ScrollViewer Style="{DynamicResource ContentScrollViewer}">
        <StackPanel Margin="{DynamicResource PageMargin}">
            <TextBlock Text="Home"
                       Style="{DynamicResource PageTitle}"
                       Margin="{DynamicResource PageHeaderMargin}" />

            <!-- Model warm-up status: a status line shown while the dictation model is warming
                 up, lifted by the app-wide cleared event so it never lingers. Caution colours to match the
                 overlay cue. -->
            <Border Style="{DynamicResource CautionBanner}"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsModelWarming, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Warming up the model so your first dictation is fast…"
                           Style="{DynamicResource BodyText}" />
            </Border>

            <!-- Current configuration at a glance: live from settings. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" Margin="0,0,16,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActiveModel, TargetNullValue='(none)'}" Style="{DynamicResource BodyText}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hotkey" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" Margin="0,0,16,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hotkey, TargetNullValue='(none)'}" Style="{DynamicResource BodyText}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Input device" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" Margin="0,0,16,4" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InputDevice, TargetNullValue='(none)'}" Style="{DynamicResource BodyText}" Margin="0,0,0,4" />
            </Grid>

            <!-- Headline usage totals: computed by the Application layer, not here; the time-saved text is
                 formatted by the view-model ("4h 23m"). -->
            <TextBlock Text="Usage"
                       Style="{DynamicResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{Binding TotalTranscriptions}"
                               Style="{DynamicResource StatValue}" />
                    <TextBlock Text="transcriptions"
                               Style="{DynamicResource CaptionText}" />
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{Binding TotalWords}"
                               Style="{DynamicResource StatValue}" />
                    <TextBlock Text="words"
                               Style="{DynamicResource CaptionText}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding EstimatedTimeSavedText}"
                               Style="{DynamicResource StatValue}" />
                    <TextBlock Text="time saved"
                               Style="{DynamicResource CaptionText}" />
                </StackPanel>
            </StackPanel>

            <!-- The most recent transcriptions — a glance into History, not the full log. -->
            <TextBlock Text="Recent"
                       Style="{DynamicResource SectionHeader}" />
            <TextBlock Text="No transcriptions yet."
                       Style="{DynamicResource CaptionText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Recent}">
                <!-- Each row's automation name is the transcript itself, so a screen reader reads the text
                     rather than the entry DTO's ToString (an id GUID and every field). -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name"
                                Value="{Binding Text}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource ListRow}">
                            <StackPanel>
                                <TextBlock Text="{Binding CreatedAt, Converter={StaticResource UtcToLocal}, StringFormat='{}{0:g}'}"
                                           Style="{DynamicResource CaptionText}" />
                                <TextBlock Text="{Binding Text}"
                                           Style="{DynamicResource BodyText}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
