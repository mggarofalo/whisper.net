<UserControl x:Class="Presentation.Shell.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Presentation.Shell">
    <UserControl.Resources>
        <!-- Declared locally so the view is self-contained: parse-time StaticResource only
             sees the view's own resources and the Application, and the smoke harness composes without one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Render stored-UTC timestamps in the user's local time; storage stays UTC. -->
        <shell:UtcToLocalConverter x:Key="UtcToLocal" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Overview"
                       FontSize="18"
                       FontWeight="SemiBold" />

            <!-- Model warm-up status: a status line shown while the dictation model is warming
                 up, lifted by the app-wide cleared event so it never lingers. Amber to match the overlay cue. -->
            <Border Background="#1FFB8C00"
                    BorderBrush="#FB8C00"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,12,0,0"
                    Visibility="{Binding IsModelWarming, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Warming up the model so your first dictation is fast…"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Current configuration at a glance: live from settings. -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Opacity="0.7" Margin="0,0,16,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActiveModel, TargetNullValue='(none)'}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hotkey" Opacity="0.7" Margin="0,0,16,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hotkey, TargetNullValue='(none)'}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Input device" Opacity="0.7" Margin="0,0,16,4" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InputDevice, TargetNullValue='(none)'}" Margin="0,0,0,4" />
            </Grid>

            <!-- Headline usage totals: computed by the Application layer, not here. -->
            <TextBlock Text="Usage"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,20,0,0" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{Binding TotalTranscriptions}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="transcriptions"
                               Opacity="0.7"
                               FontSize="11" />
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{Binding TotalWords}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="words"
                               Opacity="0.7"
                               FontSize="11" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding EstimatedTimeSaved, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="time saved"
                               Opacity="0.7"
                               FontSize="11" />
                </StackPanel>
            </StackPanel>

            <!-- The most recent transcriptions — a glance into History, not the full log. -->
            <TextBlock Text="Recent"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,20,0,0" />
            <TextBlock Text="No transcriptions yet."
                       Opacity="0.7"
                       Margin="0,8,0,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Recent}"
                          Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#40808080"
                                BorderThickness="0,0,0,1"
                                Padding="0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding CreatedAt, Converter={StaticResource UtcToLocal}, StringFormat='{}{0:g}'}"
                                           Opacity="0.6"
                                           FontSize="11" />
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
