<UserControl x:Class="Presentation.Shell.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Declared locally (WHISPER-96) so the view is self-contained: parse-time StaticResource only
             sees the view's own resources and the Application, and the smoke harness composes without one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,16">
            <TextBlock Text="Usage"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Margin="16,0,0,0"
                    Padding="12,4" />
            <!-- Lightweight loading state (WHISPER-108): visible while the activation-triggered load runs. -->
            <TextBlock Text="Loading…"
                       Opacity="0.7"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding RefreshCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <UniformGrid Columns="3">
            <StackPanel>
                <TextBlock Text="{Binding TotalTranscriptions}"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="Transcriptions"
                           Opacity="0.7" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding TotalWords}"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="Words"
                           Opacity="0.7" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding EstimatedTimeSaved, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="Est. time saved"
                           Opacity="0.7" />
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</UserControl>
