<UserControl x:Class="Presentation.Shell.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Declared locally so the view is self-contained: parse-time StaticResource only
             sees the view's own resources and the Application, and the smoke harness composes without one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!-- Typography, spacing and colour come from the shared tokens in ShellResources.xaml (WHISPER-142); the
         figures use the same StatValue/Caption pair as Home's usage block. -->
    <StackPanel Margin="{DynamicResource PageMargin}">
        <!-- Page header: the title alone on the left, the page command on the right. -->
        <Grid Margin="{DynamicResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Stats"
                       Style="{DynamicResource PageTitle}" />
            <!-- Lightweight loading state: visible while the activation-triggered load runs. -->
            <TextBlock Grid.Column="1"
                       Text="Loading…"
                       Style="{DynamicResource CaptionText}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding RefreshCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="2"
                    Content="{DynamicResource GlyphRefresh}"
                    FontFamily="{DynamicResource IconFont}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="8"
                    ToolTip="Refresh stats"
                    AutomationProperties.Name="Refresh stats"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <UniformGrid Columns="3">
            <StackPanel>
                <TextBlock Text="{Binding TotalTranscriptions}"
                           Style="{DynamicResource StatValue}" />
                <TextBlock Text="transcriptions"
                           Style="{DynamicResource CaptionText}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding TotalWords}"
                           Style="{DynamicResource StatValue}" />
                <TextBlock Text="words"
                           Style="{DynamicResource CaptionText}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding EstimatedTimeSavedText}"
                           Style="{DynamicResource StatValue}" />
                <TextBlock Text="time saved"
                           Style="{DynamicResource CaptionText}" />
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</UserControl>
