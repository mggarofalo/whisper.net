<UserControl x:Class="Presentation.Shell.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Presentation.Shell">
    <UserControl.Resources>
        <!-- Declared locally (WHISPER-96) so the view is self-contained: parse-time StaticResource only
             sees the view's own resources and the Application, and the smoke harness composes without one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Render stored-UTC timestamps in the user's local time (WHISPER-115); storage stays UTC. -->
        <shell:UtcToLocalConverter x:Key="UtcToLocal" />
    </UserControl.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock Text="History"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="Refresh"
                    Command="{Binding LoadCommand}"
                    Margin="16,0,0,0"
                    Padding="12,4" />
            <!-- Disabled once the history is exhausted (WHISPER-110): the view-model tracks whether a
                 further page may exist, so the button never offers a silent no-op. -->
            <Button Content="Load more"
                    Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding HasMorePages}"
                    Margin="8,0,0,0"
                    Padding="12,4" />
            <!-- Lightweight loading state (WHISPER-108): visible while the activation-triggered load runs. -->
            <TextBlock Text="Loading…"
                       Opacity="0.7"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding LoadCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Empty state: shown instead of the list when there is no history. -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="No transcriptions yet."
                   Opacity="0.7"
                   Margin="0,12,0,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1"
                                Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource UtcToLocal}, StringFormat='{}{0:g}'}"
                                               Opacity="0.6"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Copy"
                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Top"
                                        Padding="12,4" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
