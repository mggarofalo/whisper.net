<UserControl x:Class="Presentation.Shell.Views.AudioDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Presentation.Behaviors"
             KeyboardNavigation.TabNavigation="Local">
    <UserControl.Resources>
        <!-- Declared locally so the view is self-contained: parse-time StaticResource only
             sees the view's own resources and the Application, and the smoke harness composes without one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock x:Name="InputDeviceLabel"
                       Text="Input device"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="Refresh"
                    AutomationProperties.Name="Refresh device list"
                    Command="{Binding LoadCommand}"
                    Margin="16,0,0,0"
                    Padding="12,4" />
            <!-- Lightweight loading state: visible while the activation-triggered load runs. -->
            <TextBlock Text="Loading…"
                       Opacity="0.7"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding LoadCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- A ComboBox of capture devices by friendly name. The two-way SelectedValue binding
             is the whole contract: the view-model commits a genuine user pick and ignores the programmatic
             selection a reload performs. The stored value is the stable device id, not an index. -->
        <ComboBox x:Name="DeviceBox"
                  Width="320"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="Capture device"
                  AutomationProperties.LabeledBy="{Binding ElementName=InputDeviceLabel}"
                  ItemsSource="{Binding Devices}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}">
            <b:Interaction.Behaviors>
                <!-- Focus the picker on section activation for immediate keyboard use. -->
                <behaviors:FocusOnActivateBehavior />
            </b:Interaction.Behaviors>
        </ComboBox>

        <!-- The clear fallback state when a persisted device is no longer present (empty otherwise). -->
        <TextBlock Text="{Binding UnavailableDeviceWarning}"
                   Foreground="#B06000"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
