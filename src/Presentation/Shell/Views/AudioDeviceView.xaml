<UserControl x:Class="Presentation.Shell.Views.AudioDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Local">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock x:Name="InputDeviceLabel"
                       Text="Input device"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="Refresh"
                    AutomationProperties.Name="Refresh device list"
                    Command="{Binding LoadCommand}"
                    Margin="16,0,0,0"
                    Padding="12,4" />
        </StackPanel>

        <!-- A ComboBox of capture devices by friendly name (WHISPER-80). Selecting an entry commits and
             live-applies (handled in code-behind so the programmatic selection a reload performs is not
             mistaken for a user pick). The stored value is the stable device id, not an index. -->
        <ComboBox x:Name="DeviceBox"
                  Width="320"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="Capture device"
                  AutomationProperties.LabeledBy="{Binding ElementName=InputDeviceLabel}"
                  ItemsSource="{Binding Devices}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}"
                  SelectionChanged="OnDeviceSelectionChanged" />

        <!-- The clear fallback state when a persisted device is no longer present (empty otherwise). -->
        <TextBlock Text="{Binding UnavailableDeviceWarning}"
                   Foreground="#B06000"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
