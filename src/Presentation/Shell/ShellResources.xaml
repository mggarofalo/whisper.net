<!-- Shared resources for the settings-shell views: the converters and validation chrome
     the feature views reference by StaticResource. Owned by a standalone dictionary — merged by BOTH
     App.xaml (app-wide, as before) and ShellWindow.xaml — so the shell window is self-contained:
     resource lookup succeeds wherever the window is composed, including the STA smoke harness, which
     instantiates the real window without a live Application. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Presentation.Shell"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Converters referenced by StaticResource at parse time live IN the consuming views (see
         HistoryView/ModelView), not here: a UserControl's parse-time lookup sees only its own resources
         and the Application, and the views must compose without a live Application. The nav
         resources below are an exception: they are consumed by ShellWindow.xaml (a Window, whose parse-time
         lookup sees its own merged dictionaries — this one), not by a UserControl. -->

    <!-- Reusable native validation adorner: a red border around the offending control plus
         the INotifyDataErrorInfo message beside it, and the same message as the control's tooltip. Applied
         to validated TextBoxes so settings errors surface natively next to the field. -->
    <ControlTemplate x:Key="ValidationErrorTemplate">
        <StackPanel Orientation="Horizontal">
            <Border BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="2">
                <AdornedElementPlaceholder />
            </Border>
            <TextBlock Text="{Binding [0].ErrorContent}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </ControlTemplate>

    <!-- BasedOn keeps the Fluent TextBox look (template, theme brushes): without it this implicit style
         replaces the Fluent one and every TextBox falls back to the classic white box, unreadable in dark. -->
    <Style TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Validation.ErrorTemplate"
                Value="{StaticResource ValidationErrorTemplate}" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError"
                     Value="True">
                <Setter Property="ToolTip"
                        Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================================================
         Design tokens for the settings shell (WHISPER-142). Every colour the feature views use comes from
         here, and every colour here is a Fluent SEMANTIC brush bound by DynamicResource, so it tracks
         light/dark flips live and keeps WCAG AA contrast in both themes (the Fluent palettes are tuned per
         theme: critical text is a dark red on light and a light red on dark). The views hold no colour
         literals. Views reference these by DynamicResource: a UserControl's parse-time StaticResource
         lookup cannot see this dictionary (it sees only its own resources and the Application), while a
         DynamicResource resolves once the view sits inside the shell window, which merges it.

         Type scale: PageTitle 24 / SectionHeader 16 / Body 14 / Caption 12, plus StatValue for the usage
         figures. Spacing: a 4px base with three semantic gaps (8 within a group, 16 between groups or a
         control and its helper, 24 before a section) and a 24px page margin.
         ============================================================================================ -->

    <Thickness x:Key="PageMargin">24</Thickness>
    <Thickness x:Key="GapTight">0,8,0,0</Thickness>
    <Thickness x:Key="GapGroup">0,16,0,0</Thickness>
    <Thickness x:Key="GapSection">0,24,0,0</Thickness>
    <!-- Below a page header (title + command bar), before the page body. -->
    <Thickness x:Key="PageHeaderMargin">0,0,0,16</Thickness>

    <Style x:Key="PageTitle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="24" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="SectionHeader"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin"
                Value="0,24,0,8" />
    </Style>

    <Style x:Key="BodyText"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <!-- Secondary text: the Fluent secondary text brush, never Opacity (dimming by opacity drops below
         4.5:1 on the dark surface and also dims any glyph inside the block). -->
    <Style x:Key="CaptionText"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <!-- A form field's label above its control. -->
    <Style x:Key="FieldLabel"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyText}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>

    <Style x:Key="StatValue"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="24" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="ErrorText"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground"
                Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <!-- An empty message takes no space (otherwise an empty line pads every row). -->
        <Style.Triggers>
            <Trigger Property="Text"
                     Value="">
                <Setter Property="Visibility"
                        Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text"
                     Value="{x:Null}">
                <Setter Property="Visibility"
                        Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WarningText"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground"
                Value="{DynamicResource SystemFillColorCautionBrush}" />
        <!-- An empty message takes no space (otherwise an empty line pads every row). -->
        <Style.Triggers>
            <Trigger Property="Text"
                     Value="">
                <Setter Property="Visibility"
                        Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text"
                     Value="{x:Null}">
                <Setter Property="Visibility"
                        Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A transient status strip (the model warm-up notice): the Fluent caution surface and stroke. -->
    <Style x:Key="CautionBanner"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource SystemFillColorCautionBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="4" />
        <Setter Property="Padding"
                Value="12,8" />
    </Style>

    <!-- One list row for Home, History and Model: a theme divider underneath, uniform vertical padding. -->
    <Style x:Key="ListRow"
           TargetType="Border">
        <Setter Property="BorderBrush"
                Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness"
                Value="0,0,0,1" />
        <Setter Property="Padding"
                Value="0,8" />
    </Style>

    <!-- The active model's chip: the system accent with on-accent text, matching the nav rail's selection
         rather than a fixed blue. -->
    <Style x:Key="AccentChip"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius"
                Value="4" />
        <Setter Property="Padding"
                Value="6,1" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="AccentChipText"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!-- Compact Low/Medium/High rating chip on a model row: a neutral control stroke. -->
    <Style x:Key="RatingChip"
           TargetType="Border">
        <Setter Property="BorderBrush"
                Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="4" />
        <Setter Property="Padding"
                Value="6,1" />
        <Setter Property="Margin"
                Value="0,0,6,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <!-- The scrolling page body: the right padding reserves a gutter for the Fluent overlay scrollbar,
         which otherwise paints over the row actions (Copy / Download / Select) at the right edge. -->
    <Style x:Key="ContentScrollViewer"
           TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility"
                Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility"
                Value="Disabled" />
        <Setter Property="Padding"
                Value="0,0,16,0" />
    </Style>

    <!-- Iconography: the Fluent icon font that ships with Windows 11 (falling back to Segoe MDL2 Assets on
         older systems), with each glyph defined ONCE here so the views never carry literal code points. A
         button pairs a ButtonGlyph with its label; an icon-only button carries a ToolTip and an
         AutomationProperties.Name so it stays accessible. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:String x:Key="GlyphRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="GlyphDownload">&#xE896;</sys:String>
    <sys:String x:Key="GlyphCopy">&#xE8C8;</sys:String>
    <sys:String x:Key="GlyphSelect">&#xE73E;</sys:String>
    <sys:String x:Key="GlyphCancel">&#xE711;</sys:String>
    <sys:String x:Key="GlyphSearch">&#xE721;</sys:String>
    <sys:String x:Key="GlyphPrevious">&#xE76B;</sys:String>
    <sys:String x:Key="GlyphNext">&#xE76C;</sys:String>

    <!-- The icon half of an icon + label button. -->
    <Style x:Key="ButtonGlyph"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Margin"
                Value="0,0,8,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <!-- ============================================================================================
         Navigation sidebar theme (made theme-adaptive). The sidebar follows
         the active light/dark theme instead of a fixed dark rail: labels inherit the theme's text colour,
         and the rail / hover / pressed surfaces are theme-NEUTRAL semi-transparent grays that read on both
         light and dark. The selected tab uses the system ACCENT colour (the Fluent AccentFillColorDefault
         brush, which follows the user's Windows accent). Contrast in both themes is the Fluent theme's
         guarantee (default text on the themed surface; white-on-accent for the selected tab) rather than a
         fixed computed value — verified manually in light and dark.
         ============================================================================================ -->

    <!-- Subtle, theme-neutral rail surface and hover/pressed states (gray with alpha reads on both themes). -->
    <SolidColorBrush x:Key="NavSidebarBackgroundBrush"
                     Color="#14808080" />
    <SolidColorBrush x:Key="NavItemHoverBrush"
                     Color="#22808080" />
    <SolidColorBrush x:Key="NavItemPressedBrush"
                     Color="#38808080" />

    <!-- Marks the nav button whose section key equals the shell's CurrentSectionKey as selected. -->
    <shell:EqualityConverter x:Key="EqualityConverter" />

    <!-- Templated nav button (theme-adaptive): visible hover / pressed / keyboard-
         focus / selected states. The label inherits the theme's foreground (no fixed colour), so it adapts
         to light/dark; the active section is filled with the system accent (DynamicResource so it tracks the
         Windows accent and theme), an accent bar, bold weight, and on-accent text. -->
    <Style x:Key="NavButtonStyle"
           TargetType="Button">
        <!-- The label uses the Fluent theme's adaptive text brush so it follows light/dark.
             A keyed style has no implicit-style BasedOn, so without this the foreground would fall back to
             the framework default (~black) and read black-on-dark in dark mode. -->
        <Setter Property="Foreground"
                Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="Padding"
                Value="12,6" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <!-- Suppress the default dotted focus rectangle; the template draws its own accent ring. -->
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />
                        <Border x:Name="AccentBar"
                                Width="3"
                                Margin="0,3"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="Collapsed" />
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource NavItemHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource NavItemPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="FocusRing"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <!-- Selected: this button's section key equals the shell's CurrentSectionKey. -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                    <Binding />
                                    <Binding Path="DataContext.CurrentSectionKey"
                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="AccentBar"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
