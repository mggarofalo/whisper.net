<!-- Shared resources for the settings-shell views: the converters and validation chrome
     the feature views reference by StaticResource. Owned by a standalone dictionary — merged by BOTH
     App.xaml (app-wide, as before) and ShellWindow.xaml — so the shell window is self-contained:
     resource lookup succeeds wherever the window is composed, including the STA smoke harness, which
     instantiates the real window without a live Application. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Presentation.Shell">

    <!-- Converters referenced by StaticResource at parse time live IN the consuming views (see
         HistoryView/ModelView), not here: a UserControl's parse-time lookup sees only its own resources
         and the Application, and the views must compose without a live Application. The nav
         resources below are an exception: they are consumed by ShellWindow.xaml (a Window, whose parse-time
         lookup sees its own merged dictionaries — this one), not by a UserControl. -->

    <!-- Reusable native validation adorner: a red border around the offending control plus
         the INotifyDataErrorInfo message beside it, and the same message as the control's tooltip. Applied
         to validated TextBoxes so settings errors surface natively next to the field. -->
    <ControlTemplate x:Key="ValidationErrorTemplate">
        <StackPanel Orientation="Horizontal">
            <Border BorderBrush="#C03030"
                    BorderThickness="1"
                    CornerRadius="2">
                <AdornedElementPlaceholder />
            </Border>
            <TextBlock Text="{Binding [0].ErrorContent}"
                       Foreground="#C03030"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </ControlTemplate>

    <Style TargetType="TextBox">
        <Setter Property="Validation.ErrorTemplate"
                Value="{StaticResource ValidationErrorTemplate}" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError"
                     Value="True">
                <Setter Property="ToolTip"
                        Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================================================
         Navigation sidebar theme (made theme-adaptive). The sidebar follows
         the active light/dark theme instead of a fixed dark rail: labels inherit the theme's text colour,
         and the rail / hover / pressed surfaces are theme-NEUTRAL semi-transparent grays that read on both
         light and dark. The selected tab uses the system ACCENT colour (the Fluent AccentFillColorDefault
         brush, which follows the user's Windows accent). Contrast in both themes is the Fluent theme's
         guarantee (default text on the themed surface; white-on-accent for the selected tab) rather than a
         fixed computed value — verified manually in light and dark.
         ============================================================================================ -->

    <!-- Subtle, theme-neutral rail surface and hover/pressed states (gray with alpha reads on both themes). -->
    <SolidColorBrush x:Key="NavSidebarBackgroundBrush"
                     Color="#14808080" />
    <SolidColorBrush x:Key="NavItemHoverBrush"
                     Color="#22808080" />
    <SolidColorBrush x:Key="NavItemPressedBrush"
                     Color="#38808080" />

    <!-- Marks the nav button whose section key equals the shell's CurrentSectionKey as selected. -->
    <shell:EqualityConverter x:Key="EqualityConverter" />

    <!-- Templated nav button (theme-adaptive): visible hover / pressed / keyboard-
         focus / selected states. The label inherits the theme's foreground (no fixed colour), so it adapts
         to light/dark; the active section is filled with the system accent (DynamicResource so it tracks the
         Windows accent and theme), an accent bar, bold weight, and on-accent text. -->
    <Style x:Key="NavButtonStyle"
           TargetType="Button">
        <!-- The label uses the Fluent theme's adaptive text brush so it follows light/dark.
             A keyed style has no implicit-style BasedOn, so without this the foreground would fall back to
             the framework default (~black) and read black-on-dark in dark mode. -->
        <Setter Property="Foreground"
                Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="Padding"
                Value="12,6" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <!-- Suppress the default dotted focus rectangle; the template draws its own accent ring. -->
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />
                        <Border x:Name="AccentBar"
                                Width="3"
                                Margin="0,3"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="Collapsed" />
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource NavItemHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource NavItemPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="FocusRing"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <!-- Selected: this button's section key equals the shell's CurrentSectionKey. -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                    <Binding />
                                    <Binding Path="DataContext.CurrentSectionKey"
                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="AccentBar"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
