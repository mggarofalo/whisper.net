<!-- Shared resources for the settings-shell views (WHISPER-96): the converters and validation chrome
     the feature views reference by StaticResource. Owned by a standalone dictionary — merged by BOTH
     App.xaml (app-wide, as before) and ShellWindow.xaml — so the shell window is self-contained:
     resource lookup succeeds wherever the window is composed, including the STA smoke harness, which
     instantiates the real window without a live Application. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Presentation.Shell">

    <!-- Converters referenced by StaticResource at parse time live IN the consuming views (see
         HistoryView/ModelView), not here: a UserControl's parse-time lookup sees only its own resources
         and the Application, and the views must compose without a live Application (WHISPER-96). The nav
         resources below are an exception: they are consumed by ShellWindow.xaml (a Window, whose parse-time
         lookup sees its own merged dictionaries — this one), not by a UserControl. -->

    <!-- ============================================================================================
         Navigation sidebar theme (WHISPER-103). A deliberate dark navigation rail (a fixed surface, like
         a VS Code activity bar) so the nav never renders as the old near-white #F3F3F3 panel against the
         dark content. Centralized here as shared brushes so no view carries hardcoded color hex (AC3), and
         every foreground/background pair clears WCAG 2.1 AA (contrast computed in the @WHISPER-103 spec):
           label #F0F0F0 on rail #1E1E1E .......... 14.6:1  (>= 4.5)
           label #F0F0F0 on hover #2D2D2D ......... 12.1:1  (>= 4.5)
           label #F0F0F0 on pressed #3A3A3A ....... 10.0:1  (>= 4.5)
           selected label #FFFFFF on #0E639C ....... 6.4:1  (>= 4.5)
           selected accent #4CC2FF vs rail ......... 8.3:1  (>= 3, non-text indicator)
         ============================================================================================ -->
    <SolidColorBrush x:Key="NavSidebarBackgroundBrush"
                     Color="#1E1E1E" />
    <SolidColorBrush x:Key="NavItemForegroundBrush"
                     Color="#F0F0F0" />
    <SolidColorBrush x:Key="NavItemHoverBackgroundBrush"
                     Color="#2D2D2D" />
    <SolidColorBrush x:Key="NavItemPressedBackgroundBrush"
                     Color="#3A3A3A" />
    <SolidColorBrush x:Key="NavItemSelectedBackgroundBrush"
                     Color="#0E639C" />
    <SolidColorBrush x:Key="NavItemSelectedForegroundBrush"
                     Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavItemAccentBrush"
                     Color="#4CC2FF" />

    <!-- Marks the nav button whose section key equals the shell's CurrentSectionKey as selected. -->
    <shell:EqualityConverter x:Key="EqualityConverter" />

    <!-- Templated nav button (WHISPER-103): visible hover / pressed / keyboard-focus / selected states,
         all driven from the shared brushes above. The active section gets a filled background, an accent
         bar, bold weight, and high-contrast text so it is unmistakably distinct. -->
    <Style x:Key="NavButtonStyle"
           TargetType="Button">
        <Setter Property="Foreground"
                Value="{StaticResource NavItemForegroundBrush}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="Padding"
                Value="12,6" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <!-- Suppress the default dotted focus rectangle; the template draws its own high-contrast ring. -->
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />
                        <Border x:Name="AccentBar"
                                Width="3"
                                Margin="0,3"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Background="{StaticResource NavItemAccentBrush}"
                                Visibility="Collapsed" />
                        <Border x:Name="FocusRing"
                                BorderBrush="{StaticResource NavItemAccentBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource NavItemHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource NavItemPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="FocusRing"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                        <!-- Selected: this button's section key equals the shell's CurrentSectionKey. -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                    <Binding />
                                    <Binding Path="DataContext.CurrentSectionKey"
                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource NavItemSelectedBackgroundBrush}" />
                            <Setter TargetName="AccentBar"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource NavItemSelectedForegroundBrush}" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reusable native validation adorner (WHISPER-77): a red border around the offending control plus
         the INotifyDataErrorInfo message beside it, and the same message as the control's tooltip. Applied
         to validated TextBoxes so settings errors surface natively next to the field. -->
    <ControlTemplate x:Key="ValidationErrorTemplate">
        <StackPanel Orientation="Horizontal">
            <Border BorderBrush="#C03030"
                    BorderThickness="1"
                    CornerRadius="2">
                <AdornedElementPlaceholder />
            </Border>
            <TextBlock Text="{Binding [0].ErrorContent}"
                       Foreground="#C03030"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </ControlTemplate>

    <Style TargetType="TextBox">
        <Setter Property="Validation.ErrorTemplate"
                Value="{StaticResource ValidationErrorTemplate}" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError"
                     Value="True">
                <Setter Property="ToolTip"
                        Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
