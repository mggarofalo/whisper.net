<UserControl x:Class="Presentation.Shell.Controls.HotkeyCaptureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.IsTabStop="False">
    <!-- A read-only capture field (WHISPER-79): it shows the captured combination and records the next one
         the user presses. Focusable but read-only, with no context menu, so its own text shortcuts never
         steal the keystroke we want to capture. Accessibility (WHISPER-83): the inner TextBox is the single
         tab stop, and its AutomationProperties.Name announces the current binding to a screen reader, since
         the displayed chord is the value the user needs spoken. -->
    <TextBox x:Name="DisplayBox"
             IsReadOnly="True"
             IsReadOnlyCaretVisible="False"
             Focusable="True"
             ContextMenu="{x:Null}"
             VerticalContentAlignment="Center"
             Padding="6,4"
             MinWidth="200"
             AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}, StringFormat='Dictation hotkey, current binding {0}'}"
             PreviewKeyDown="OnPreviewKeyDown"
             GotKeyboardFocus="OnGotKeyboardFocus" />
</UserControl>
