<Window x:Class="Presentation.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Logic.AppManagement.Shell;assembly=Logic.AppManagement"
        xmlns:views="clr-namespace:Presentation.Shell.Views"
        Title="Whisper"
        Width="720"
        Height="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The shared converters + validation chrome the feature views reference:
                     merged at window level too, so the shell is self-contained — its views resolve their
                     resources wherever the window is composed, Application or not (the smoke harness). -->
                <ResourceDictionary Source="/Presentation;component/Shell/ShellResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Map each feature view-model to its view so the content region renders the active section. -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModelViewModel}">
                <views:ModelView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioDeviceViewModel}">
                <views:AudioDeviceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HotkeyViewModel}">
                <views:HotkeyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatsViewModel}">
                <views:StatsView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Navigation region: one button per registered section, dispatching the shell's NavigateCommand.
             The rail follows the active theme and highlights the selected tab with the system accent
; a theme switcher is pinned to its footer. -->
        <Border DockPanel.Dock="Left"
                Width="160"
                Background="{StaticResource NavSidebarBackgroundBrush}">
            <DockPanel>
                <!-- Theme switcher: System / Light / Dark, persisted and applied live. -->
                <StackPanel DockPanel.Dock="Bottom"
                            Margin="8,4,8,8">
                    <TextBlock Text="Theme"
                               Opacity="0.7"
                               FontSize="11"
                               Margin="4,0,0,2" />
                    <ComboBox ItemsSource="{Binding Theme.Themes}"
                              SelectedItem="{Binding Theme.SelectedTheme, Mode=TwoWay}"
                              AutomationProperties.Name="Theme" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Sections}"
                              Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding}"
                                    Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content region: the active feature view-model, rendered via the data templates above. -->
        <ContentControl Content="{Binding CurrentViewModel}" />
    </DockPanel>
</Window>
