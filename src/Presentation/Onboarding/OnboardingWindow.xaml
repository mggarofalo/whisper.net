<Window x:Class="Presentation.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Whisper"
        Width="520"
        Height="520"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Let's set up dictation"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="Pick a model, your microphone, and a hotkey. Nothing is downloaded unless you ask."
                       TextWrapping="Wrap"
                       Opacity="0.8"
                       Margin="0,4,0,16" />

            <!-- Model -->
            <TextBlock Text="1. Model"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,16">
                <TextBox x:Name="ModelBox"
                         Text="base.en"
                         Width="160"
                         Padding="6,4" />
                <Button Content="Use model"
                        Command="{Binding ChooseModelCommand}"
                        CommandParameter="{Binding Text, ElementName=ModelBox}"
                        Margin="8,0,0,0"
                        Padding="12,4" />
                <Button Content="Download"
                        Command="{Binding ApproveModelDownloadCommand}"
                        CommandParameter="{Binding Text, ElementName=ModelBox}"
                        Margin="8,0,0,0"
                        Padding="12,4" />
                <Button Content="Skip download"
                        Command="{Binding DeclineModelDownloadCommand}"
                        Margin="8,0,0,0"
                        Padding="12,4" />
            </StackPanel>

            <!-- Audio device -->
            <TextBlock Text="2. Input device"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,16">
                <TextBox x:Name="DeviceBox"
                         Width="220"
                         Padding="6,4" />
                <Button Content="Use device"
                        Command="{Binding ChooseDeviceCommand}"
                        CommandParameter="{Binding Text, ElementName=DeviceBox}"
                        Margin="8,0,0,0"
                        Padding="12,4" />
            </StackPanel>

            <!-- Hotkey -->
            <TextBlock Text="3. Hotkey"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,16">
                <TextBox x:Name="HotkeyBox"
                         Text="Ctrl+Win"
                         Width="160"
                         Padding="6,4" />
                <Button Content="Use hotkey"
                        Command="{Binding ChooseHotkeyCommand}"
                        CommandParameter="{Binding Text, ElementName=HotkeyBox}"
                        Margin="8,0,0,0"
                        Padding="12,4" />
            </StackPanel>

            <!-- Permissions -->
            <TextBlock Text="4. Permissions"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,16">
                <Button Content="Check permissions"
                        Command="{Binding RequestPermissionsCommand}"
                        Padding="12,4" />
                <TextBlock Text="{Binding PermissionsGranted, StringFormat='Granted: {0}'}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Content="Finish setup"
                    Command="{Binding CompleteCommand}"
                    HorizontalAlignment="Left"
                    Padding="16,6"
                    Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
