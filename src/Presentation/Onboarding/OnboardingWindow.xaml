<Window x:Class="Presentation.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Whisper"
        Width="560"
        Height="600"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Let's set up dictation"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="Pick a model, your microphone, and a hotkey. Nothing is downloaded unless you ask."
                       TextWrapping="Wrap"
                       Opacity="0.8"
                       Margin="0,4,0,16" />

            <!-- Model: pick from the catalog; using an un-downloaded model downloads it with live progress. -->
            <TextBlock Text="1. Model"
                       FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Models}"
                          Margin="0,4,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1"
                                BorderBrush="#22000000"
                                Padding="0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold" />
                                    <ProgressBar Height="4"
                                                 Margin="0,4,8,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding DownloadPercent}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           Opacity="0.7"
                                           Text="{Binding DownloadState}" />
                                <Button Grid.Column="2"
                                        Content="Use"
                                        Padding="12,4"
                                        Command="{Binding DataContext.UseModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Input device: chosen from the enumerated capture devices, not typed by hand. -->
            <TextBlock Text="2. Input device"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,16">
                <ComboBox x:Name="DeviceCombo"
                          Width="240"
                          Padding="6,4"
                          ItemsSource="{Binding Devices}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id" />
                <Button Content="Use device"
                        Command="{Binding ChooseDeviceCommand}"
                        CommandParameter="{Binding SelectedValue, ElementName=DeviceCombo}"
                        Margin="8,0,0,0"
                        Padding="12,4" />
            </StackPanel>

            <!-- Hotkey -->
            <TextBlock Text="3. Hotkey"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,16">
                <TextBox x:Name="HotkeyBox"
                         Text="Ctrl+Win"
                         Width="160"
                         Padding="6,4" />
                <Button Content="Use hotkey"
                        Command="{Binding ChooseHotkeyCommand}"
                        CommandParameter="{Binding Text, ElementName=HotkeyBox}"
                        Margin="8,0,0,0"
                        Padding="12,4" />
            </StackPanel>

            <!-- Permissions -->
            <TextBlock Text="4. Permissions"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,16">
                <Button Content="Check permissions"
                        Command="{Binding RequestPermissionsCommand}"
                        Padding="12,4" />
                <TextBlock Text="{Binding PermissionsGranted, StringFormat='Granted: {0}'}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Finish is disabled until a model is active and a device is chosen (CanComplete). -->
            <Button Content="Finish setup"
                    Command="{Binding CompleteCommand}"
                    IsEnabled="{Binding CanComplete}"
                    HorizontalAlignment="Left"
                    Padding="16,6"
                    Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
