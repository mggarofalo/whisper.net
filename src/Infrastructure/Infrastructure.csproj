<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure: implements the Application ports against real systems (Whisper.net, NAudio,
    ONNX VAD, SendInput, persistence). The only layer that talks to the outside world. It composes
    the Logic.* behaviors with native adapters, so it references Application, Domain, and every
    Logic.* project. Only Presentation is allowed to reference Infrastructure in turn.
  -->
  <ItemGroup>
    <!-- The interop struct-size guard (WHISPER-88) needs to read an internal of Win32KeyboardInput. -->
    <InternalsVisibleTo Include="Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="SharpHook" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
    <!-- In-app auto-update over the release channel (WHISPER-29): the UpdateManager adapter. -->
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <!--
    Voice-activity detection model (WHISPER-31/66): the Silero VAD ONNX asset (MIT, ~1.8 MB) ships with
    the app — no runtime download. It copies to `assets/silero_vad.onnx` in the build output, which is
    where OnnxVadSession resolves it (AppContext.BaseDirectory/assets). Declared once here: Content with
    CopyToOutputDirectory flows transitively to every referencing project (Presentation, the test
    projects) and into the Velopack single-file publish, where it lands next to the exe.
  -->
  <ItemGroup>
    <Content Include="..\..\assets\silero_vad.onnx" Link="assets\silero_vad.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Logic.AppManagement\Logic.AppManagement.csproj" />
    <ProjectReference Include="..\Logic.AudioManagement\Logic.AudioManagement.csproj" />
    <ProjectReference Include="..\Logic.ModelManagement\Logic.ModelManagement.csproj" />
    <ProjectReference Include="..\Logic.GpuContactPoint\Logic.GpuContactPoint.csproj" />
  </ItemGroup>

</Project>
